# Copy this file to .env before starting the stack.
COMPOSE_PROJECT_NAME=mail-attachment-hub

POSTGRES_DB=mailhub
POSTGRES_USER=mailhub
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_PORT=5432

REDIS_PORT=6379
REDIS_MAXMEMORY=256mb

# Used by later application steps.
APP_ENV=development
APP_BASE_URL=http://localhost:8080
APP_SECRET_KEY=replace-with-at-least-32-random-characters
TZ=Europe/Stockholm
