# Copy this file to .env before starting the stack.
COMPOSE_PROJECT_NAME=mail-attachment-hub

POSTGRES_DB=mailhub
POSTGRES_USER=mailhub
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_PORT=5432

REDIS_PORT=6379
REDIS_MAXMEMORY=256mb

APP_ENV=development
APP_BASE_URL=http://localhost:8080
APP_SECRET_KEY=replace-with-at-least-32-random-characters
LOG_LEVEL=INFO
READINESS_TIMEOUT_SECONDS=2
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8080
TZ=Europe/Stockholm
