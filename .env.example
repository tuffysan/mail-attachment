COMPOSE_PROJECT_NAME=mail-attachment-hub
TZ=Europe/Stockholm

POSTGRES_DB=mailhub
POSTGRES_USER=mailhub
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_PORT=5432

REDIS_PORT=6379
REDIS_MAXMEMORY=256mb

APP_ENV=development
APP_BASE_URL=http://localhost:8080
APP_SECRET_KEY=replace-with-at-least-32-random-characters
LOG_LEVEL=INFO
LOG_FORMAT=json
REQUEST_ID_HEADER=X-Request-ID
CORRELATION_ID_HEADER=X-Correlation-ID
SECURITY_HEADERS_ENABLED=true
REQUEST_LOG_EXCLUDED_PATHS=/health/live,/health/ready
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8080
READINESS_TIMEOUT_SECONDS=2
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters
ADMIN_DISPLAY_NAME=Administrator

FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000

# IMAP connection test timeout
IMAP_TIMEOUT_SECONDS=15

# Email engine
SYNC_INTERVAL_SECONDS=300
SYNC_BATCH_SIZE=100
SYNC_RETRY_ATTEMPTS=3
SYNC_RETRY_DELAY_SECONDS=10
EXTRACT_ZIP_ATTACHMENTS=true
MAX_ZIP_FILES=100
MAX_ZIP_EXPANDED_BYTES=104857600

# Optional OAuth application credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Remote storage upload retries
STORAGE_RETRY_ATTEMPTS=3
